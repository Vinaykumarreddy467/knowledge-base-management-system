# --- database -------------------------------------------------------------
DB_NAME=kbms
DB_USERNAME=kbms
DB_PASSWORD=change-me
# Host port for the container. 5432 is often taken by a native PostgreSQL install.
DB_PORT=55432
DB_URL=jdbc:postgresql://localhost:55432/kbms

# --- backend --------------------------------------------------------------
SERVER_PORT=8080
# Must be at least 32 characters in any real environment.
KBMS_JWT_SECRET=replace-with-at-least-32-random-characters
KBMS_JWT_TTL_MINUTES=480
KBMS_CORS_ORIGINS=http://localhost:4200

# First administrator, created only when the user table is empty. No default password.
KBMS_ADMIN_EMAIL=admin@example.com
KBMS_ADMIN_PASSWORD=replace-with-a-strong-password

# --- storage & uploads ----------------------------------------------------
KBMS_STORAGE_DIR=./data/uploads
KBMS_MAX_UPLOAD_SIZE=20MB

# --- local Ollama (default, no API key) -----------------------------------
# Ollama must be running: `ollama serve`, then `ollama pull nomic-embed-text-v2-moe:latest`
# and `ollama pull gemma:2b`. Verify with `ollama list`.
KBMS_EMBEDDING_PROVIDER=ollama
KBMS_EMBEDDING_MODEL=nomic-embed-text-v2-moe:latest
KBMS_EMBEDDING_BASE_URL=http://localhost:11434
KBMS_EMBEDDING_TIMEOUT=120
# nomic-embed-text-v2-moe really returns 768 dimensions. This value must equal the width the
# model returns, and it is baked into the schema: it is the Flyway `vector_dimension`
# placeholder for document_chunks.embedding. Changing it on an existing database needs a new
# migration (ALTER TABLE document_chunks ALTER COLUMN embedding TYPE vector(N);) and a re-index.
KBMS_VECTOR_DIMENSION=768

KBMS_LLM_PROVIDER=ollama
KBMS_LLM_MODEL=gemma:2b
KBMS_LLM_BASE_URL=http://localhost:11434
KBMS_LLM_TIMEOUT=180

# --- hosted providers (optional) ------------------------------------------
# Set the provider to "openai" to use any OpenAI-compatible /v1 endpoint instead, and supply keys.
# KBMS_EMBEDDING_PROVIDER=openai
# KBMS_EMBEDDING_BASE_URL=https://api.openai.com/v1
# KBMS_EMBEDDING_API_KEY=
# KBMS_EMBEDDING_MODEL=text-embedding-3-small
# KBMS_LLM_PROVIDER=openai
# KBMS_LLM_BASE_URL=https://api.openai.com/v1
# KBMS_LLM_API_KEY=
# KBMS_LLM_MODEL=gpt-4o-mini
#
# Development only: an offline deterministic hash embedder (lexical, not semantic). Never use it
# for a corpus you care about; existing chunks must be re-indexed when switching.
# KBMS_EMBEDDING_PROVIDER=local

# --- retrieval ------------------------------------------------------------
KBMS_CHUNK_CHARS=1200
KBMS_CHUNK_OVERLAP=150
KBMS_RAG_TOP_K=5
KBMS_RAG_MIN_SIMILARITY=0.35
KBMS_RAG_MAX_QUESTION=2000
KBMS_RAG_MAX_CONTEXT=24000
KBMS_RAG_NO_CONTEXT_ANSWER=I could not find enough information in the knowledge base to answer that question.
